generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LOCKED
  ARCHIVED
}

enum DeliveryChannel {
  EMAIL
  SMS
}

enum ResetPurpose {
  FORGOT_PASSWORD
  FIRST_LOGIN
}

enum EmploymentType {
  CDI
  CDD
  STAGE
  FREELANCE
  CONSULTANT
  TEMPORAIRE
  APPRENTISSAGE
  OTHER
}

enum RecruitmentRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CLOSED
}

enum JobPostingStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  ARCHIVED
}

enum CandidateSource {
  CAREER_SITE
  LINKEDIN
  REFERRAL
  AGENCY
  JOB_BOARD
  SOCIAL_MEDIA
  OTHER
}

enum ApplicationStage {
  APPLIED
  SCREENING
  TEST
  HR_INTERVIEW
  TECHNICAL_INTERVIEW
  MANAGER_INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum ApplicationStatus {
  ACTIVE
  HIRED
  REJECTED
  WITHDRAWN
}

enum InterviewType {
  HR
  TECHNICAL
  MANAGERIAL
  FINAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OnboardingTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum RecruitmentWeeklyPlanStatus {
  PLANNED
  IN_PROGRESS
  DONE
  BLOCKED
  CANCELLED
}

enum RecruitmentPlanningEntityType {
  WEEKLY_PLAN
  PIPELINE_STEP
  SCORECARD_CRITERION
}

enum RecruitmentPlanningAction {
  CREATED
  UPDATED
  DELETED
}

enum TalentDocumentOwnerType {
  CANDIDATE
  ONBOARDING
}

enum TalentDocumentCategory {
  CV
  IDENTITY
  DIPLOMA
  CERTIFICATE
  CONTRACT
  OFFER_LETTER
  OTHER
}

enum CandidateResumeStatus {
  PENDING
  PROCESSING
  PARSED
  FAILED
  REVIEW_REQUIRED
}

enum CandidateSkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum AtsDecisionStatus {
  TO_REVIEW
  SHORTLISTED
  HOLD
  REJECTED
  INTERVIEW_RECOMMENDED
  OFFER_RECOMMENDED
}

enum ScoreEvidenceSource {
  CV
  APPLICATION_FORM
  TEST
  INTERVIEW
  MANUAL
  AI_INFERENCE
}

enum AssessmentType {
  QCM
  WRITTEN_CASE
  PRACTICAL_CASE
  TECHNICAL
  PERSONALITY
  LANGUAGE
  CUSTOM
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum AssessmentSubmissionStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  SCORED
  REVIEWED
  CANCELLED
}

enum AssessmentQuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  TRUE_FALSE
  SHORT_TEXT
  LONG_TEXT
  FILE_UPLOAD
  NUMERIC
}

enum InterviewCriterionType {
  TECHNICAL
  BEHAVIORAL
  CULTURE
  COMMUNICATION
  LEADERSHIP
  MOTIVATION
  CUSTOM
}

enum AiRunType {
  CV_PARSE
  CV_SUMMARY
  ATS_SCREENING
  TEST_SCORING
  INTERVIEW_QUESTION_GEN
  INTERVIEW_SUMMARY
  OFFER_RECOMMENDATION
}

enum AiRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AiRecommendationType {
  SHORTLIST
  REVIEW
  REJECT
  INTERVIEW
  TEST
  OFFER
}

enum AiRecommendationStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  EXPIRED
}

model Tenant {
  id                   String                         @id @default(cuid())
  name                 String
  slug                 String                         @unique
  status               TenantStatus                   @default(ACTIVE)
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  users                User[]
  sessions             Session[]
  recruitmentRequests  RecruitmentRequest[]
  jobPostings          JobPosting[]
  candidates           Candidate[]
  applications         Application[]
  interviews           Interview[]
  hiringOffers         HiringOffer[]
  onboardingPlans      OnboardingPlan[]
  talentDocuments      TalentDocument[]
  candidateResumeProfiles    CandidateResumeProfile[]
  candidateSkills            CandidateSkill[]
  candidateExperiences       CandidateExperience[]
  candidateEducations        CandidateEducation[]
  candidateCertifications    CandidateCertification[]
  jobScorecards              JobScorecard[]
  jobScorecardCriteria       JobScorecardCriterion[]
  applicationScreenings      ApplicationScreening[]
  applicationScreeningItems  ApplicationScreeningItem[]
  assessmentCampaigns        AssessmentCampaign[]
  assessmentQuestions        AssessmentQuestion[]
  assessmentSubmissions      AssessmentSubmission[]
  assessmentScoreItems       AssessmentScoreItem[]
  interviewScorecards        InterviewScorecard[]
  interviewScorecardCriteria InterviewScorecardCriterion[]
  interviewEvaluations       InterviewEvaluation[]
  interviewEvaluationItems   InterviewEvaluationItem[]
  aiEvaluationRuns           AiEvaluationRun[]
  aiEvaluationEvidences      AiEvaluationEvidence[]
  aiRecommendations          AiRecommendation[]
  weeklyPlans          RecruitmentWeeklyPlan[]
  pipelineSteps        RecruitmentPipelineStep[]
  scorecardCriteria    RecruitmentScorecardCriterion[]
  planningHistories    RecruitmentPlanningHistory[]
  performanceCycles    PerformanceCycle[]
  performanceGoals     PerformanceGoal[]
  performanceReviews   PerformanceReview[]
  performanceFeedbacks PerformanceFeedback[]
  employeeTrainings    EmployeeTraining[]
  employees            Employee[]
  kpiDefinitions       KpiDefinition[]
  kpiAssignments       KpiAssignment[]
  kpiCheckIns          KpiCheckIn[]
}

model User {
  id                         String                          @id @default(cuid())
  tenantId                   String
  firstName                  String
  lastName                   String
  email                      String?                         @unique
  phone                      String?                         @unique
  avatarUrl                  String?
  passwordHash               String
  status                     UserStatus                      @default(INVITED)
  mustChangePassword         Boolean                         @default(true)
  firstLoginAt               DateTime?
  lastLoginAt                DateTime?
  failedLoginCount           Int                             @default(0)
  lockedUntil                DateTime?
  preferredChannel           DeliveryChannel                 @default(EMAIL)
  roleId                     String
  createdById                String?
  createdAt                  DateTime                        @default(now())
  updatedAt                  DateTime                        @updatedAt
  tenant                     Tenant                          @relation(fields: [tenantId], references: [id])
  role                       Role                            @relation(fields: [roleId], references: [id])
  createdBy                  User?                           @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers               User[]                          @relation("UserCreator")
  sessions                   Session[]
  passwordResets             PasswordReset[]
  permissions                UserPermission[]
  modules                    UserModuleAccess[]
  requestedRecruitments      RecruitmentRequest[]            @relation("RecruitmentRequester")
  approvedRecruitments       RecruitmentRequest[]            @relation("RecruitmentApprover")
  managedJobPostings         JobPosting[]                    @relation("HiringManager")
  recruitedJobPostings       JobPosting[]                    @relation("RecruiterOwner")
  conductedInterviews        Interview[]                     @relation("InterviewInterviewer")
  interviewEvaluations       InterviewEvaluation[]           @relation("InterviewEvaluationEvaluator")
  acceptedAiRecommendations  AiRecommendation[]             @relation("AiRecommendationAcceptedBy")
  uploadedTalentDocuments    TalentDocument[]                @relation("TalentDocumentUploader")
  employeeProfile            Employee?                       @relation("UserEmployeeProfile")
  employeeContractsCreated   EmployeeContract[]              @relation("EmployeeContractCreator")
  uploadedEmployeeDocuments  EmployeeDocument[]              @relation("EmployeeDocumentUploader")
  verifiedEmployeeDocuments  EmployeeDocument[]              @relation("EmployeeDocumentVerifier")
  accessAuditsAsAccount      EmployeeAccessAudit[]           @relation("EmployeeAccessAccount")
  accessAuditsRecorded       EmployeeAccessAudit[]           @relation("EmployeeAccessRecordedBy")
  employmentEventsCreated    EmployeeEmploymentEvent[]       @relation("EmploymentEventCreator")
  weeklyPlansCreated         RecruitmentWeeklyPlan[]         @relation("WeeklyPlanCreatedBy")
  weeklyPlansUpdated         RecruitmentWeeklyPlan[]         @relation("WeeklyPlanUpdatedBy")
  pipelineStepsCreated       RecruitmentPipelineStep[]       @relation("PipelineStepCreatedBy")
  pipelineStepsUpdated       RecruitmentPipelineStep[]       @relation("PipelineStepUpdatedBy")
  scorecardCriteriaCreated   RecruitmentScorecardCriterion[] @relation("ScorecardCriterionCreatedBy")
  scorecardCriteriaUpdated   RecruitmentScorecardCriterion[] @relation("ScorecardCriterionUpdatedBy")
  recruitmentPlanningActions RecruitmentPlanningHistory[]    @relation("RecruitmentPlanningHistoryPerformedBy")

  @@index([tenantId])
  @@index([roleId])
}

model Role {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  description String?
  isSystem    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  users       User[]
  permissions RolePermission[]
  modules     RoleModuleAccess[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
  users       UserPermission[]
}

model AppModule {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  roles       RoleModuleAccess[]
  users       UserModuleAccess[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPermission {
  userId       String
  permissionId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model RoleModuleAccess {
  roleId    String
  moduleId  String
  createdAt DateTime  @default(now())
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    AppModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([roleId, moduleId])
}

model UserModuleAccess {
  userId    String
  moduleId  String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    AppModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([userId, moduleId])
}

model Session {
  id             String    @id @default(cuid())
  tenantId       String
  userId         String
  tokenHash      String    @unique
  ipAddress      String?
  userAgent      String?
  lastActivityAt DateTime
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id         String          @id @default(cuid())
  userId     String
  channel    DeliveryChannel
  purpose    ResetPurpose    @default(FORGOT_PASSWORD)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, expiresAt])
}

model RecruitmentRequest {
  id              String                   @id @default(cuid())
  tenantId        String
  title           String
  departmentName  String
  location        String?
  employmentType  EmploymentType
  headcount       Int                      @default(1)
  budgetAmount    Decimal?                 @db.Decimal(12, 2)
  currency        String?                  @db.VarChar(10)
  targetStartDate DateTime?
  reason          String?
  status          RecruitmentRequestStatus @default(DRAFT)
  requestedById   String
  approvedById    String?
  approvalComment String?
  approvedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  requestedBy     User                     @relation("RecruitmentRequester", fields: [requestedById], references: [id])
  approvedBy      User?                    @relation("RecruitmentApprover", fields: [approvedById], references: [id])
  jobPostings     JobPosting[]

  @@index([tenantId, status])
  @@index([requestedById, status])
  @@index([departmentName, status])
}

model JobPosting {
  id                   String              @id @default(cuid())
  tenantId             String
  recruitmentRequestId String?
  code                 String              @unique
  title                String
  description          String
  departmentName       String
  location             String?
  employmentType       EmploymentType
  openings             Int                 @default(1)
  status               JobPostingStatus    @default(DRAFT)
  publishedAt          DateTime?
  closedAt             DateTime?
  recruiterId          String?
  hiringManagerId      String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  tenant               Tenant              @relation(fields: [tenantId], references: [id])
  recruitmentRequest   RecruitmentRequest? @relation(fields: [recruitmentRequestId], references: [id])
  recruiter            User?               @relation("RecruiterOwner", fields: [recruiterId], references: [id])
  hiringManager        User?               @relation("HiringManager", fields: [hiringManagerId], references: [id])
  applications         Application[]
  scorecards           JobScorecard[]
  assessmentCampaigns  AssessmentCampaign[]
  interviewScorecards  InterviewScorecard[]

  @@index([tenantId, status])
  @@index([recruitmentRequestId])
  @@index([status, departmentName])
}

model Candidate {
  id           String           @id @default(cuid())
  tenantId     String
  firstName    String
  lastName     String
  email        String?          @unique
  phone        String?          @unique
  source       CandidateSource  @default(OTHER)
  resumeUrl    String?
  currentHeadline      String?
  linkedinUrl          String?
  portfolioUrl         String?
  city                 String?
  country              String?
  yearsOfExperience    Decimal? @db.Decimal(5, 2)
  summary      String?
  tags         String[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  applications Application[]
  documents    TalentDocument[]
  resumeProfiles       CandidateResumeProfile[]
  skills               CandidateSkill[]
  experiences          CandidateExperience[]
  educations           CandidateEducation[]
  certifications       CandidateCertification[]
  aiRuns               AiEvaluationRun[]

  @@index([tenantId, createdAt])
  @@index([source])
}

model Application {
  id              String            @id @default(cuid())
  tenantId        String
  jobPostingId    String
  candidateId     String
  stage           ApplicationStage  @default(APPLIED)
  kanbanOrder     Int               @default(0)
  status          ApplicationStatus @default(ACTIVE)
  score           Decimal?          @db.Decimal(5, 2)
  atsStatus       AtsDecisionStatus @default(TO_REVIEW)
  atsScore        Decimal?          @db.Decimal(5, 2)
  cvScore         Decimal?          @db.Decimal(5, 2)
  testScore       Decimal?          @db.Decimal(5, 2)
  interviewScore  Decimal?          @db.Decimal(5, 2)
  finalScore      Decimal?          @db.Decimal(5, 2)
  scoreCalculatedAt DateTime?
  appliedAt       DateTime          @default(now())
  lastStageAt     DateTime          @default(now())
  rejectionReason String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  jobPosting      JobPosting        @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  candidate       Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviews      Interview[]
  offer           HiringOffer?
  onboardingPlan  OnboardingPlan?
  screening           ApplicationScreening?
  assessmentSubmissions AssessmentSubmission[]
  interviewEvaluations  InterviewEvaluation[]
  aiRuns               AiEvaluationRun[]
  recommendations      AiRecommendation[]

  @@unique([jobPostingId, candidateId])
  @@index([tenantId, status])
  @@index([tenantId, stage, kanbanOrder])
  @@index([jobPostingId, stage, status])
  @@index([candidateId])
}

model Interview {
  id            String          @id @default(cuid())
  tenantId      String
  applicationId String
  interviewerId String?
  type          InterviewType
  status        InterviewStatus @default(SCHEDULED)
  scheduledAt   DateTime
  completedAt   DateTime?
  location      String?
  meetingLink   String?
  feedback      String?
  score         Decimal?        @db.Decimal(5, 2)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer   User?           @relation("InterviewInterviewer", fields: [interviewerId], references: [id])
  evaluation    InterviewEvaluation?

  @@index([tenantId, status])
  @@index([applicationId, status])
  @@index([interviewerId])
}

model HiringOffer {
  id                String      @id @default(cuid())
  tenantId          String
  applicationId     String      @unique
  salaryAmount      Decimal?    @db.Decimal(12, 2)
  currency          String?     @db.VarChar(10)
  proposedStartDate DateTime?
  status            OfferStatus @default(DRAFT)
  notes             String?
  sentAt            DateTime?
  respondedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model OnboardingPlan {
  id             String           @id @default(cuid())
  tenantId       String
  applicationId  String           @unique
  status         OnboardingStatus @default(NOT_STARTED)
  startDate      DateTime?
  departmentName String?
  siteName       String?
  managerName    String?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  application    Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tasks          OnboardingTask[]
  documents      TalentDocument[]

  @@index([tenantId, status])
}

model OnboardingTask {
  id               String               @id @default(cuid())
  onboardingPlanId String
  title            String
  description      String?
  ownerLabel       String?
  dueDate          DateTime?
  status           OnboardingTaskStatus @default(TODO)
  completedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  onboardingPlan   OnboardingPlan       @relation(fields: [onboardingPlanId], references: [id], onDelete: Cascade)

  @@index([onboardingPlanId, status])
}

model TalentDocument {
  id               String                  @id @default(cuid())
  tenantId         String
  ownerType        TalentDocumentOwnerType
  category         TalentDocumentCategory  @default(OTHER)
  candidateId      String?
  onboardingPlanId String?
  uploadedById     String?
  title            String
  originalName     String
  storedName       String
  mimeType         String?
  sizeBytes        Int
  storagePath      String
  publicUrl        String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  tenant           Tenant                  @relation(fields: [tenantId], references: [id])
  candidate        Candidate?              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  onboardingPlan   OnboardingPlan?         @relation(fields: [onboardingPlanId], references: [id], onDelete: Cascade)
  uploadedBy       User?                   @relation("TalentDocumentUploader", fields: [uploadedById], references: [id])
  resumeProfiles   CandidateResumeProfile[]
  aiEvidenceDocuments AiEvaluationEvidence[] @relation("AiEvidenceSourceDocument")

  @@index([tenantId, createdAt])
  @@index([ownerType, category])
  @@index([candidateId])
  @@index([onboardingPlanId])
}

model CandidateResumeProfile {
  id                    String                @id @default(cuid())
  tenantId              String
  candidateId           String
  documentId            String?
  status                CandidateResumeStatus @default(PENDING)
  parsedFullName        String?
  parsedEmail           String?
  parsedPhone           String?
  parsedSummary         String?
  totalYearsExperience  Decimal?              @db.Decimal(5, 2)
  currentRole           String?
  currentEmployer       String?
  languages             String[]
  rawExtractionJson     Json?
  normalizedProfileJson Json?
  extractedAt           DateTime?
  reviewedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate             Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  document              TalentDocument?       @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([tenantId, candidateId, status])
  @@index([documentId])
}

model CandidateSkill {
  id              String              @id @default(cuid())
  tenantId        String
  candidateId     String
  name            String
  category        String?
  level           CandidateSkillLevel?
  yearsExperience Decimal?            @db.Decimal(5, 2)
  sourceLabel     String?
  isAiExtracted   Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate       Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([tenantId, candidateId])
  @@index([tenantId, name])
}

model CandidateExperience {
  id             String    @id @default(cuid())
  tenantId       String
  candidateId    String
  companyName    String
  jobTitle       String
  startDate      DateTime?
  endDate        DateTime?
  isCurrent      Boolean   @default(false)
  durationMonths Int?
  description    String?
  industry       String?
  location       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([tenantId, candidateId, startDate])
}

model CandidateEducation {
  id           String    @id @default(cuid())
  tenantId     String
  candidateId  String
  institution  String
  degree       String?
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  levelLabel   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([tenantId, candidateId])
}

model CandidateCertification {
  id             String    @id @default(cuid())
  tenantId       String
  candidateId    String
  name           String
  issuer         String?
  issuedAt       DateTime?
  expiresAt      DateTime?
  credentialCode String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([tenantId, candidateId])
}

model JobScorecard {
  id          String                 @id @default(cuid())
  tenantId    String
  jobPostingId String
  code        String
  name        String
  description String?
  isDefault   Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobPosting  JobPosting             @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  criteria    JobScorecardCriterion[]
  screenings  ApplicationScreening[]

  @@unique([tenantId, jobPostingId, code])
  @@index([tenantId, jobPostingId])
}

model JobScorecardCriterion {
  id             String               @id @default(cuid())
  tenantId       String
  scorecardId    String
  code           String
  label          String
  description    String?
  weight         Decimal              @db.Decimal(5, 2)
  minimumScore   Decimal?             @db.Decimal(5, 2)
  knockout       Boolean              @default(false)
  evidenceSource ScoreEvidenceSource  @default(CV)
  orderIndex     Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
