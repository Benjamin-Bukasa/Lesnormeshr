model Department {
  id                String       @id @default(cuid())
  code              String       @unique
  name              String       @unique
  description       String?
  parentId          String?
  managerEmployeeId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  parent            Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          Department[] @relation("DepartmentHierarchy")
  manager           Employee?    @relation("DepartmentManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  positions         Position[]
  employees         Employee[]

  @@index([parentId])
  @@index([managerEmployeeId])
}

model Position {
  id           String      @id @default(cuid())
  code         String      @unique
  title        String
  description  String?
  level        String?
  isManagerial Boolean     @default(false)
  departmentId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees    Employee[]

  @@index([departmentId])
}

model WorkLocation {
  id           String     @id @default(cuid())
  code         String     @unique
  name         String
  addressLine  String?
  city         String?
  country      String?
  timezone     String?
  isHeadOffice Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  employees    Employee[]
}

model CostCenter {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[]
}

model WorkingSchedule {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  timezone          String?
  weeklyHours       Decimal            @default(40) @db.Decimal(5, 2)
  startTime         String?
  endTime           String?
  breakMinutes      Int?
  isFlexible        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  employees         Employee[]
  attendanceRecords AttendanceRecord[]
}

model Employee {
  id                   String                     @id @default(cuid())
  tenantId             String
  employeeNumber       String                     @unique
  userId               String?                    @unique
  firstName            String
  middleName           String?
  lastName             String
  preferredName        String?
  gender               Gender?
  maritalStatus        MaritalStatus?
  dateOfBirth          DateTime?
  placeOfBirth         String?
  nationality          String?
  photoUrl             String?
  workEmail            String?                    @unique
  workPhone            String?
  personalEmail        String?
  personalPhone        String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  postalCode           String?
  country              String?
  nationalIdNumber     String?                    @unique
  taxNumber            String?
  socialSecurityNumber String?
  employmentType       EmploymentType             @default(CDI)
  employmentStatus     EmployeeLifecycleStatus    @default(ACTIVE)
  hireDate             DateTime
  probationEndDate     DateTime?
  confirmationDate     DateTime?
  terminationDate      DateTime?
  terminationReason    String?
  gradeLevel           String?
  departmentId         String?
  positionId           String?
  locationId           String?
  costCenterId         String?
  managerEmployeeId    String?
  scheduleId           String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  tenant               Tenant                     @relation(fields: [tenantId], references: [id])
  user                 User?                      @relation("UserEmployeeProfile", fields: [userId], references: [id], onDelete: SetNull)
  department           Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position             Position?                  @relation(fields: [positionId], references: [id], onDelete: SetNull)
  location             WorkLocation?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  costCenter           CostCenter?                @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  manager              Employee?                  @relation("EmployeeManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  directReports        Employee[]                 @relation("EmployeeManager")
  schedule             WorkingSchedule?           @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  managedDepartments   Department[]               @relation("DepartmentManager")
  emergencyContacts    EmployeeEmergencyContact[]
  contracts            EmployeeContract[]
  payrollProfile       PayrollProfile?
  bankAccounts         EmployeeBankAccount[]
  compensations        CompensationComponent[]
  attendanceRecords    AttendanceRecord[]
  leaveBalances        EmployeeLeaveBalance[]
  leaveRequests        EmployeeLeaveRequest[]
  leaveApprovals       EmployeeLeaveApproval[]
  goals                PerformanceGoal[]
  reviewsAsReviewee    PerformanceReview[]        @relation("Reviewee")
  reviewsAsReviewer    PerformanceReview[]        @relation("Reviewer")
  feedbacksGiven       PerformanceFeedback[]      @relation("FeedbackAuthor")
  feedbacksReceived    PerformanceFeedback[]      @relation("FeedbackReceiver")
  documents            EmployeeDocument[]
  accessAudits         EmployeeAccessAudit[]
  employmentEvents     EmployeeEmploymentEvent[]
  offboarding          EmployeeOffboarding?
  trainings            EmployeeTraining[]
  managedKpiDefinitions KpiDefinition[]
  kpiAssignments       KpiAssignment[]              @relation("KpiAssignmentEmployee")
  kpiAssignmentsManaged KpiAssignment[]             @relation("KpiAssignmentManager")

  @@index([tenantId, employmentStatus])
  @@index([departmentId])
  @@index([positionId])
  @@index([locationId])
  @@index([costCenterId])
  @@index([managerEmployeeId])
  @@index([employmentStatus])
}

