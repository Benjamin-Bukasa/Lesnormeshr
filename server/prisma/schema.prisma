  id               String          @id @default(cuid())
  employeeId       String
  payrollProfileId String?
  bankName         String?
  branchName       String?
  accountName      String?
  accountNumber    String
  iban             String?
  swiftCode        String?
  mobileProvider   String?
  mobileNumber     String?
  isPrimary        Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  employee         Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollProfile   PayrollProfile? @relation(fields: [payrollProfileId], references: [id], onDelete: SetNull)

  @@unique([employeeId, accountNumber])
  @@index([employeeId, isPrimary])
  @@index([payrollProfileId])
}

model CompensationComponent {
  id               String           @id @default(cuid())
  employeeId       String
  payrollProfileId String?
  name             String
  type             CompensationType
  amount           Decimal          @db.Decimal(12, 2)
  currency         String           @db.VarChar(10)
  isRecurring      Boolean          @default(true)
  taxable          Boolean          @default(true)
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollProfile   PayrollProfile?  @relation(fields: [payrollProfileId], references: [id], onDelete: SetNull)

  @@index([employeeId, type])
  @@index([payrollProfileId])
  @@index([effectiveFrom, effectiveTo])
}

model AttendanceRecord {
  id              String                @id @default(cuid())
  employeeId      String
  scheduleId      String?
  workDate        DateTime
  checkInAt       DateTime?
  checkOutAt      DateTime?
  workedMinutes   Int                   @default(0)
  overtimeMinutes Int                   @default(0)
  lateMinutes     Int                   @default(0)
  status          AttendanceEntryStatus @default(PRESENT)
  source          String?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  employee        Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schedule        WorkingSchedule?      @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@unique([employeeId, workDate])
  @@index([scheduleId])
  @@index([workDate, status])
}

model LeaveType {
  id                String                 @id @default(cuid())
  code              String                 @unique
  name              String
  description       String?
  unit              LeaveUnit              @default(DAY)
  defaultAllowance  Decimal?               @db.Decimal(8, 2)
  carryForwardLimit Decimal?               @db.Decimal(8, 2)
  isPaid            Boolean                @default(true)
  requiresApproval  Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  balances          EmployeeLeaveBalance[]
  requests          EmployeeLeaveRequest[]
}

model EmployeeLeaveBalance {
  id             String    @id @default(cuid())
  employeeId     String
  leaveTypeId    String
  year           Int
  openingBalance Decimal   @default(0) @db.Decimal(8, 2)
  earned         Decimal   @default(0) @db.Decimal(8, 2)
  used           Decimal   @default(0) @db.Decimal(8, 2)
  pending        Decimal   @default(0) @db.Decimal(8, 2)
  carryForward   Decimal   @default(0) @db.Decimal(8, 2)
  available      Decimal   @default(0) @db.Decimal(8, 2)
  updatedAt      DateTime  @updatedAt
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([leaveTypeId, year])
}

model EmployeeLeaveRequest {
  id             String                  @id @default(cuid())
  employeeId     String
  leaveTypeId    String
  startDate      DateTime
  endDate        DateTime
  startHalfDay   Boolean                 @default(false)
  endHalfDay     Boolean                 @default(false)
  requestedUnits Decimal                 @db.Decimal(8, 2)
  reason         String?
  status         LeaveRequestStatus      @default(PENDING)
  workflowStep   Int                     @default(1)
  appliedAt      DateTime                @default(now())
  decidedAt      DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  employee       Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType               @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  approvals      EmployeeLeaveApproval[]

  @@index([employeeId, status])
  @@index([leaveTypeId, status])
  @@index([startDate, endDate])
}

model EmployeeLeaveApproval {
  id                 String               @id @default(cuid())
  leaveRequestId     String
  approverEmployeeId String
  stepOrder          Int
  status             ApprovalStepStatus   @default(PENDING)
  comment            String?
  actedAt            DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  leaveRequest       EmployeeLeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  approver           Employee             @relation(fields: [approverEmployeeId], references: [id], onDelete: Restrict)

  @@unique([leaveRequestId, stepOrder])
  @@index([approverEmployeeId, status])
}

model PerformanceCycle {
  id          String                 @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  periodStart DateTime
  periodEnd   DateTime
  status      PerformanceCycleStatus @default(DRAFT)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  tenant      Tenant                 @relation(fields: [tenantId], references: [id])
  goals       PerformanceGoal[]
  reviews     PerformanceReview[]
  feedbacks   PerformanceFeedback[]
  trainings   EmployeeTraining[]
  kpiAssignments KpiAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId, status, periodStart, periodEnd])
}

model PerformanceGoal {
  id              String           @id @default(cuid())
  tenantId         String
  employeeId      String
  cycleId         String
  kpiDefinitionId String?
  title           String
  description     String?
  weight          Decimal?         @db.Decimal(5, 2)
  progressPercent Decimal          @default(0) @db.Decimal(5, 2)
  targetValue     String?
  achievedValue   String?
  dueDate         DateTime?
  note            String?
  status          GoalStatus       @default(NOT_STARTED)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycle           PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  kpiDefinition   KpiDefinition?   @relation(fields: [kpiDefinitionId], references: [id], onDelete: SetNull)
  checkIns        KpiCheckIn[]

  @@index([tenantId, status])
  @@index([employeeId, status])
  @@index([cycleId, status])
}

model PerformanceReview {
  id                 String           @id @default(cuid())
  tenantId           String
  cycleId            String
  revieweeEmployeeId String
  reviewerEmployeeId String
  reviewType         ReviewType
  status             ReviewStatus     @default(DRAFT)
  overallScore       Decimal?         @db.Decimal(5, 2)
  strengths          String?
  developmentAreas   String?
  comments           String?
  submittedAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  cycle              PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  reviewee           Employee         @relation("Reviewee", fields: [revieweeEmployeeId], references: [id], onDelete: Cascade)
  reviewer           Employee         @relation("Reviewer", fields: [reviewerEmployeeId], references: [id], onDelete: Restrict)

  @@unique([cycleId, revieweeEmployeeId, reviewerEmployeeId, reviewType])
  @@index([tenantId, status])
  @@index([revieweeEmployeeId, status])
  @@index([reviewerEmployeeId, status])
}

model PerformanceFeedback {
  id             String            @id @default(cuid())
  tenantId        String
  cycleId        String?
  fromEmployeeId String?
  toEmployeeId   String
  feedbackType   FeedbackType
  title          String?
  message        String
  rating         Decimal?          @db.Decimal(3, 2)
  isAnonymous    Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  cycle          PerformanceCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  author         Employee?         @relation("FeedbackAuthor", fields: [fromEmployeeId], references: [id], onDelete: SetNull)
  receiver       Employee          @relation("FeedbackReceiver", fields: [toEmployeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([cycleId])
  @@index([toEmployeeId, createdAt])
}

model EmployeeTraining {
  id             String            @id @default(cuid())
  tenantId        String
  employeeId     String
  cycleId        String?
  title          String
  provider       String?
  startDate      DateTime?
  endDate        DateTime?
  status         TrainingStatus    @default(PLANNED)
  hours          Decimal?          @db.Decimal(5, 2)
  score          Decimal?          @db.Decimal(5, 2)
  certificateUrl String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycle          PerformanceCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([employeeId, status])
  @@index([cycleId])
}

model KpiDefinition {
  id                String            @id @default(cuid())
  tenantId          String
  code              String
  name              String
  scope             String
  directionName     String?
  metricType        String
  unit              String?
  defaultWeight     Decimal?          @db.Decimal(5, 2)
  ownerLabel        String?
  status            String            @default("Draft")
  description       String?
  managerEmployeeId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  managerEmployee   Employee?         @relation(fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  goals             PerformanceGoal[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model KpiAssignment {
  id                String            @id @default(cuid())
  tenantId          String
  cycleId           String
  employeeId        String
  managerEmployeeId String?
  summary           String?
  assignedKpis      Int               @default(0)
  totalWeight       Decimal?          @db.Decimal(5, 2)
  completionPercent Decimal           @default(0) @db.Decimal(5, 2)
  riskLevel         String            @default("Medium")
  status            String            @default("Active")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  cycle             PerformanceCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee          Employee          @relation("KpiAssignmentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  managerEmployee   Employee?         @relation("KpiAssignmentManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([cycleId, employeeId])
}

model KpiCheckIn {
  id              String          @id @default(cuid())
  tenantId        String
  goalId          String
  title           String
  checkInDate     DateTime
  progressPercent Decimal?        @db.Decimal(5, 2)
  blocker         String?
  supportNeeded   String?
  nextActions     String?
  status          String          @default("Scheduled")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  goal            PerformanceGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([goalId, checkInDate])
}

model EmployeeDocument {
  id               String                   @id @default(cuid())
  employeeId       String
  category         EmployeeDocumentCategory @default(OTHER)
  title            String
  documentNumber   String?
  issuedBy         String?
  issuedAt         DateTime?
  expiresAt        DateTime?
  originalName     String
  storedName       String
  mimeType         String?
  sizeBytes        Int
  storagePath      String
  publicUrl        String
  uploadedByUserId String?
  verifiedByUserId String?
  verifiedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  employee         Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy       User?                    @relation("EmployeeDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  verifiedBy       User?                    @relation("EmployeeDocumentVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([employeeId, category])
  @@index([expiresAt])
}

model EmployeeAccessAudit {
  id               String             @id @default(cuid())
  employeeId       String
  userId           String?
  roleCode         String?
  permissionCodes  String[]
  moduleCodes      String[]
  accessStatus     SystemAccessStatus @default(ACTIVE)
  recordedAt       DateTime           @default(now())
  recordedByUserId String?
  notes            String?
  employee         Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  accountUser      User?              @relation("EmployeeAccessAccount", fields: [userId], references: [id], onDelete: SetNull)
  recordedBy       User?              @relation("EmployeeAccessRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([employeeId, recordedAt])
  @@index([userId, recordedAt])
}

model EmployeeEmploymentEvent {
  id              String              @id @default(cuid())
  employeeId      String
  eventType       EmploymentEventType
  effectiveDate   DateTime
  title           String
  description     String?
  previousValues  Json?
  newValues       Json?
  salaryBefore    Decimal?            @db.Decimal(12, 2)
  salaryAfter     Decimal?            @db.Decimal(12, 2)
  currency        String?             @db.VarChar(10)
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  employee        Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdByUser   User?               @relation("EmploymentEventCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveDate, eventType])
}

model EmployeeOffboarding {
  id                    String                     @id @default(cuid())
  employeeId            String                     @unique
  status                OffboardingStatus          @default(INITIATED)
  reason                String?
  noticeDate            DateTime?
  lastWorkingDate       DateTime?
  exitInterviewDate     DateTime?
  knowledgeTransferDone Boolean                    @default(false)
  assetsReturned        Boolean                    @default(false)
  finalSettlementAmount Decimal?                   @db.Decimal(12, 2)
  settlementCurrency    String?                    @db.VarChar(10)
  comments              String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  employee              Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  checklistItems        OffboardingChecklistItem[]

  @@index([status, lastWorkingDate])
}

model OffboardingChecklistItem {
  id            String              @id @default(cuid())
  offboardingId String
  title         String
  description   String?
  ownerLabel    String?
  dueDate       DateTime?
  status        ChecklistItemStatus @default(PENDING)
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  offboarding   EmployeeOffboarding @relation(fields: [offboardingId], references: [id], onDelete: Cascade)

  @@index([offboardingId, status])
}
